{
  "name": "@local/erp-sales-dashboard",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "ERP 销售仪表盘：业绩达成、订单质量、回款售后、客户激活、获客转化、学习成长、订单待办、客户档案（含中国省份地图）、业务员档案，共 10 个页签，全部由 ERP/STD MCP 只读工具驱动。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md",
    "CONTRACT.md",
    "selfcheck.mjs",
    "verify-host.mjs",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
